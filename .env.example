# Chic A Boo unified API — copy to .env and fill values
# Local: cp .env.example .env
# Render: paste into Environment

PORT=8000
APP_ENV=development
LOG_LEVEL=info

# Neon / Postgres (asyncpg). Keep ?ssl=require for Neon.
DATABASE_URL=postgresql+asyncpg://chicaboo:chicaboo@localhost:5433/chicaboo

REDIS_URL=redis://localhost:6379

# Comma-separated frontend origins
CORS_ORIGINS=https://www.chicaboo.co,https://chicaboo.co,https://admin.chicaboo.co

# Public storefront URL (reset links + email branding)
SITE_URL=https://www.chicaboo.co

# Customer JWT (RS256)
# Render: paste full PEM into JWT_PRIVATE_KEY + JWT_PUBLIC_KEY (multiline OK).
# Local: leave those empty and use file paths below (openssl → keys/*.pem).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
JWT_REFRESH_SECRET=change-me-local-dev-refresh-secret-min-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

OTP_TTL_SECONDS=600
PASSWORD_RESET_TTL_SECONDS=3600

# Email — Resend primary (verify chicaboo.co domain in Resend dashboard)
RESEND_API_KEY=
EMAIL_FROM=noreply@chicaboo.co
EMAIL_FROM_NAME=Chic A Boo
EMAIL_REPLY_TO=support@chicaboo.co
EMAIL_ADMIN=admin@chicaboo.co
# SMTP fallback (Gmail app password or other SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Provider-agnostic phone settings.
PHONE_COUNTRY_CODE=91
OTP_LENGTH=6

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_VERIFY_EMAIL=10
RATE_LIMIT_FORGOT_PASSWORD=5
RATE_LIMIT_RESET_PASSWORD=10
RATE_LIMIT_REFRESH=30
RATE_LIMIT_PHONE_OTP=5
RATE_LIMIT_RESEND_VERIFICATION=5

# Admin JWT (HS256)
ADMIN_JWT_SECRET=change-me-local-dev-admin-secret-min-32-chars
ADMIN_JWT_TTL_SECONDS=28800
ADMIN_MFA_ISSUER=Chic A Boo Admin

# Cloudflare R2
R2_BUCKET=chicaboo-assets
R2_BUCKET_NAME=chicaboo-assets
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=
AVATAR_MAX_SIZE_BYTES=5242880
AVATAR_UPLOAD_URL_TTL_SECONDS=900
AVATAR_GET_URL_TTL_SECONDS=3600

# Razorpay (from https://dashboard.razorpay.com — Settings > API Keys / Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Checkout / commerce (amounts in paise; 1 rupee = 100 paise)
SHIPPING_FLAT_PAISE=0            # flat shipping charge, 0 = free shipping
FREE_SHIPPING_THRESHOLD_PAISE=0  # order total above which shipping is free (0 = disabled)
DEFAULT_GST_RATE_BPS=0           # default GST in basis points (1800 = 18%); 0 = no GST
PRICES_INCLUDE_GST=true          # catalog prices are GST-inclusive (Indian retail convention)

# Seller details printed on the GST invoice.
# GST is OPTIONAL: leave COMPANY_GSTIN blank and the document is issued as a
# "Bill of Supply". Fill GSTIN + STATE_CODE + per-product tax_rate_bps once
# registered and it upgrades to a full "Tax Invoice" automatically.
COMPANY_LEGAL_NAME=Chic A Boo
COMPANY_ADDRESS_LINE1=
COMPANY_ADDRESS_LINE2=
COMPANY_CITY=
COMPANY_STATE=
COMPANY_STATE_CODE=              # GST state code, e.g. 09 = Uttar Pradesh
COMPANY_POSTAL_CODE=
COMPANY_GSTIN=
COMPANY_PAN=
COMPANY_EMAIL=support@chicaboo.co
COMPANY_PHONE=
INVOICE_PREFIX=CAB
INVOICE_R2_PREFIX=invoices

SENTRY_DSN=

# --- WhatsApp Business Platform (Meta Cloud API) ---------------------------
# SERVER-SIDE ONLY. Never expose ACCESS_TOKEN or APP_SECRET to a client, and
# never mirror them into a NEXT_PUBLIC_* variable.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
# Echoed back on Meta's GET handshake when you register the webhook.
# Pick any random string; it must match what you enter in the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=
# Defaults to WHATSAPP_APP_SECRET when blank — Meta signs with the app secret.
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_LANGUAGE=en

# --- Channel policy --------------------------------------------------------
# WhatsApp is the only registered transport; any other value fails to route.
OTP_PRIMARY_CHANNEL=whatsapp
TRANSACTIONAL_PRIMARY_CHANNEL=whatsapp
MARKETING_PRIMARY_CHANNEL=whatsapp

# --- Retry policy ----------------------------------------------------------
# Gaps before attempts 2 and 3. A timeout is never retried.
NOTIFICATION_RETRY_DELAYS_SECONDS=[300,900]
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_UNKNOWN_RECONCILE_SECONDS=300

# --- OTP lifecycle ---------------------------------------------------------
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
RATE_LIMIT_OTP_PER_PHONE_HOURLY=5
RATE_LIMIT_OTP_PER_IP_HOURLY=20

# --- Campaigns & marketing -------------------------------------------------
# Pacing a blast protects the number's Meta quality rating, which OTP needs too.
CAMPAIGN_BATCH_SIZE=50
CAMPAIGN_BATCH_PAUSE_SECONDS=1.0

# Abandoned-cart ladder, in hours after the cart went quiet.
CART_REMINDER_FIRST_HOURS=1
CART_REMINDER_SECOND_HOURS=24
CART_REMINDER_COUPON_HOURS=48
# Coupon handed out by the third reminder. Empty disables that rung.
CART_REMINDER_COUPON_CODE=
